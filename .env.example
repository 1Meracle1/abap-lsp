# Zed and VS Code stdio server path.
export __ABAP_LSP_SERVER_PATH="$PWD/bin/debug/abap_language_server"

# Currently unsupported debug server path alias.
# export __ABAP_LSP_SERVER_DEBUG="$PWD/bin/debug/abap_language_server"

# Currently unsupported TCP transport override for an already running server.
# export __ABAP_LSP_CONNECT="127.0.0.1:9472"

# SAP ADT connection values. Prefer one variable from each alias group.
# export ABAP_ADT_URL="https://sap.example.com/sap/bc/adt"
# export ABAP_ADT_BASE_URL="https://sap.example.com"
# export SAPBASE_URL="https://sap.example.com"

# export ABAP_ADT_USER="YOUR_SAP_USERNAME"
# export ABAP_ADT_USERNAME="YOUR_SAP_USERNAME"
# export SAPUSER="YOUR_SAP_USERNAME"

# export ABAP_ADT_PASSWORD="YOUR_SAP_PASSWORD"
# export SAPPASS="YOUR_SAP_PASSWORD"

# Optional SAP client.
# export ABAP_ADT_CLIENT="100"
# export SAPCLIENT="100"

# Optional SAP-side type-pool resolver endpoint.
# export ABAP_TYPEPOOL_RESOLVER_URL="https://sap.example.com/sap/bc/zabapls/typepool"

# Optional default dependency cache location inputs. These are normally provided
# by the OS; set only when you intentionally want to alter cache discovery.
# export XDG_CACHE_HOME="$PWD/.cache"
# export HOME="$HOME"
# export LOCALAPPDATA="C:\\Users\\you\\AppData\\Local"
# export USERPROFILE="C:\\Users\\you"

# Optional Unix wrapper override for a non-PATH Odin compiler.
# export ODIN_EXE="/path/to/odin"
