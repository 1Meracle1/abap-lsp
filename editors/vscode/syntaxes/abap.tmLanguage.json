{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "ABAP",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#numbers"
		},
		{
			"name": "if-block",
			"begin": "(?i:\\bIF\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.if.abap"
				}
			},
			"end": "(?i:\\bENDIF\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endif.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "class-block",
			"begin": "(?i:\\bCLASS\\b(?!-))",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.class.abap"
				}
			},
			"end": "(?i:\\bENDCLASS\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endclass.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "method-block",
			"begin": "(?i:\\bMETHOD\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.method.abap"
				}
			},
			"end": "(?i:\\bENDMETHOD\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endmethod.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "case-block",
			"begin": "(?i:\\bCASE\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.case.abap"
				}
			},
			"end": "(?i:\\bENDCASE\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endcase.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "interface-block",
			"begin": "(?i:\\bINTERFACE\\b(?!-))",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.interface.abap"
				}
			},
			"end": "(?i:\\bENDINTERFACE\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endinterface.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "try-block",
			"begin": "(?i:\\bTRY\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.try.abap"
				}
			},
			"end": "(?i:\\bENDTRY\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endtry.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "loop-block",
			"begin": "(?i:\\bLOOP\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.loop.abap"
				}
			},
			"end": "(?i:\\bENDLOOP\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.endloop.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		},
		{
			"name": "do-block",
			"begin": "(?i:\\bDO\\b)",
			"beginCaptures": {
				"0": {
					"name": "keyword.control.do.abap"
				}
			},
			"end": "(?i:\\bENDDO\\b)",
			"endCaptures": {
				"0": {
					"name": "keyword.control.enddo.abap"
				}
			},
			"patterns": [
				{
					"include": "#expressions"
				}
			]
		}
	],
	"repository": {
		"expressions": {
			"patterns": [
				{
					"include": "#keywords"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#comments"
				},
				{
					"include": "#numbers"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.abap",
					"match": "(?i:\\b(SUBMATCHES|BYTE|GLOBAL|VALUES|CN|CO|CP|BETWEEN|RESULTS|SWITCH|PRIMARY|REDUCE|EMPTY|INIT|BASE|POOLS|REFERENCE|RESUMABLE|OF|FILTERS|REQUESTED|SUPPLIED|COND|OCCURRENCES|SOURCE|XML|RESULT|STARTING|NULL|RESPECTING|BLANKS|BACKGROUND|TASK|ACCEPTING|DUPLICATE|KEYS|STABLE|NEXT|PACKAGE|SIZE|ORDER|KEEPING|TARGET|CAST|ROWS|TIMES|BIT|COMPONENTS|DATE|ZONE|DATA|SELECT|FROM|TABLE|INSTANCE|FRIENDS|ABSTRACT|WHERE|PROGRAM|DISPLAY|FILTER|JOIN|INSERT|UPDATE|INTERFACE|DEFERRED|DELETE|LOOP|ENDLOOP|COMMIT|WORK|ROLLBACK|WHILE|ENDWHILE|ELSE|ELSEIF|ENDIF|IF|STRUCTURE|OPTIONAL|UNASSIGN|INITIALIZATION|UNTIL|CASE|WHEN|ENDCASE|PERFORM|CALL|FORM|ENDFORM|MODULE|FUNCTION|ENDFUNCTION|RETURN|TRY|CATCH|ENDTRY|DO|ENDDO|MOVE|APPEND|CONTINUE|BREAK|POINT|CHECK|CLEAR|CONSTANTS|TYPES|FIELD|SYMBOLS|TABLES|INCLUDE|DEFINE|END|PAGE|AND|OR|NOT|EQ|NE|GT|LT|GE|LE|ADD|SUBTRACT|MULTIPLY|DIVIDE|CONCATENATE|SPLIT|REPLACE|READ|DESCRIBE|TRANSLATE|NEW|INTERFACES|ENDINTERFACE|CREATE|ADJACENT|DUPLICATES|COMPARING|MODIFY|CLASS|ENDCLASS|DEFINITION|INHERITING|PUBLIC|PRIVATE|PROTECTED|SECTION|TYPE|METHODS|IMPORTING|CHANGING|USING|EXPORTING|LIKE|REDEFINITION|METHOD|ENDMETHOD|IMPLEMENTATION|IS|INITIAL|RAISING|INTO|RAISE|EXCEPTION|TO|SORT|BY|WITH|KEY|TRANSPORTING|NO|FIELDS|INDEX|AT|LINE|NEW|LINE|WRITE|ULINE|CONDENSE|COMPONENT|ASSIGN|ASSIGNING|ASSIGNED|REF|MESSAGE|SEPARATED|STRUCTURE|APPENDING|FOR|ALL|ENTRIES|BINARY|SEARCH|DESCENDING|ASCENDING|FREE|RANGE|EXCEPT|OUT|GROUP|LET|THEN|STOP|EXCEPTIONS|SUBMIT|VIA|JOB|NUMBER|OTHERS|HANDLE|BOUND|BEGIN|END|SORTED|UNIQUE|OBJECT|SHIFT|LEFT|IN|FIND|FIRST|OCCURRENCE|MATCH|OFFSET|REFRESH|GET|TIME|STAMP|FIELD|RECEIVING|FIELD|SYMBOL|INNER|OUTER|LINES|DELETING|LEADING|TRAILING|DESTINATION|CONV|VALUE|GAPS|SINGLE|ID|STANDARD|HASHED|ALPHA|AS|ON|FINAL|TESTING|DURATION|SHORT|RISK|LEVEL|HARMLESS|TEST|SEAM|INJECTION|CS|CIRCULAR|PLACES|REPORT|PARAMETERS|OBLIGATORY|DEFAULT|START|SELECTION|UPPER|LOWER|LEAVE|LIST|PROCESSING|STATICS|OPTIONS|RETURNING|IGNORING|REGEX|WAIT|UP|SECONDS|SCREEN|ENDMODULE|OUTPUT|SET|PF|STATUS|TITLEBAR|CONTROLS|TABSTRIP|CURSOR|INPUT|CORRESPONDING|CONVERT|HANDLER|EVENT|ENDSELECT|LENGTH|AUTHORITY|NON|ADD|TABLE|SEARCH|TRANSPORTING|NO|FIELDS|TYPE|KEY|CORRESPONDING|WHERE|CHARACTER|MODE|JUSTIFIED|GROUPING|SIGN|DECIMALS|ALIASES|ASSERT|AUTHORITY|CHECK|BACK|BADI|CLASS|EVENTS|POOL|CLOSE|COLLECT|COMMUNICATION|COMPUTE|CONTEXTS|DATASET|DEMAND|DETAIL|DISTANCE|EDITOR|CALL|END|SELECTION|ENHANCEMENT|ENHANCEMENT|POINT|ENHANCEMENT|SECTION|EVENTS|EXEC|EXTRACT|FETCH|FIELD|GROUPS|FORMAT|FUNCTION|POOL|HIDE|IMPORT|INFOTYPES|INTERFACE|POOL|LOAD|LOAD|PROGRAM|LOCAL|LOG|POINT|MAXIMUM|MEMORY|MINIMUM|NEW|PAGE|NEW|SECTION|NODES|OLE|OPEN|OVERLAY|PACK|POSITION|PRINT|CONTROL|PROCEDURE|PROVIDE|PUT|RANGES|RECEIVE|REJECT|RESERVE|RESUME|RETRY|SCROLL|SELECT|OPTIONS|SELECTION|SCREEN|SQL|SUM|SUMMARY|SUMMING|SUPPLY|SUPPRESS|SYNTAX|CHECK|SYSTEM|EXCEPTIONS|TEXT|TRANSACTION|TRANSFORMATION|TRANSFER|TRUNCATE|UNPACK|WINDOW|ENDAT|EXIT)\\b)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.single.abap",
					"match": "'(?:''|[^'\\r\\n])*'"
				},
				{
					"name": "string.quoted.backtick.abap",
					"match": "`(?:``|[^`\\r\\n])*`"
				},
				{
					"name": "string.template.abap",
					"begin": "\\|",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.abap"
						}
					},
					"end": "(?<!\\\\)\\|",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.abap"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.abap",
							"match": "\\\\[\\\\\\|\\{\\}]"
						},
						{
							"name": "meta.interpolation.abap",
							"begin": "(?<!\\\\)\\{",
							"beginCaptures": {
								"0": {
									"name": "punctuation.section.interpolation.begin.abap"
								}
							},
							"end": "(?<!\\\\)\\}",
							"endCaptures": {
								"0": {
									"name": "punctuation.section.interpolation.end.abap"
								}
							},
							"patterns": [
								{
									"include": "#keywords"
								},
								{
									"include": "#numbers"
								},
								{
									"include": "#strings"
								}
							]
						}
					]
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.star.abap",
					"match": "^[ \\t]*\\*.*$"
				},
				{
					"name": "comment.line.double-quote.abap",
					"match": "\".*$"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.abap",
					"match": "\\b\\d+(\\.\\d+)?\\b"
				}
			]
		}
	},
	"scopeName": "source.abap"
}
