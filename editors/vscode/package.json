{
  "name": "abap-lsp",
  "displayName": "ABAP LSP",
  "description": "Source-first ABAP language support powered by the Rust ABAP LSP server.",
  "version": "0.0.1",
  "publisher": "1meracle1",
  "license": "MIT",
  "author": "ABAP LSP contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/1Meracle1/abap-lsp.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/1Meracle1/abap-lsp/issues"
  },
  "homepage": "https://github.com/1Meracle1/abap-lsp#readme",
  "preview": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "abap",
    "sap",
    "lsp",
    "adt",
    "language server"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:abap",
    "workspaceContains:abapls.toml",
    "onCommand:abap-ls.createLinkedProject",
    "onCommand:abap-ls.searchRepositoryObjects",
    "onCommand:abap-ls.addEditableAdtObjectToWorkspace",
    "onCommand:abap-ls.createWorkspaceManifest",
    "onCommand:abap-ls.refreshDependencyCache",
    "onCommand:abap-ls.stopLanguageServer",
    "onCommand:abap-ls.restartLanguageServer"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "commands": [
      {
        "command": "abap-ls.createLinkedProject",
        "title": "ABAP LSP: Create Linked ABAP Project"
      },
      {
        "command": "abap-ls.searchRepositoryObjects",
        "title": "ABAP LSP: Search Repository Objects"
      },
      {
        "command": "abap-ls.addEditableAdtObjectToWorkspace",
        "title": "ABAP LSP: Add Editable ADT Object to Workspace"
      },
      {
        "command": "abap-ls.createWorkspaceManifest",
        "title": "ABAP LSP: Create Workspace Manifest"
      },
      {
        "command": "abap-ls.refreshDependencyCache",
        "title": "ABAP LSP: Refresh Dependency Cache"
      },
      {
        "command": "abap-ls.stopLanguageServer",
        "title": "ABAP LSP: Stop Language Server"
      },
      {
        "command": "abap-ls.restartLanguageServer",
        "title": "ABAP LSP: Restart Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ABAP LSP",
      "properties": {
        "abap-ls.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "abap-ls.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "verbose",
          "description": "Traces the communication between VS Code and the language server."
        },
        "abap-ls.serverTransport": {
          "scope": "window",
          "type": "string",
          "enum": [
            "stdio",
            "tcp"
          ],
          "default": "stdio",
          "description": "How the extension connects to the language server: spawn abap-ls.serverExecutable and speak LSP over stdio (production), or connect to an already-running server over TCP (development / debugging)."
        },
        "abap-ls.serverExecutable": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Path to the abap_lsp_server binary when serverTransport is \"stdio\". Overrides are: environment variables __ABAP_LSP_SERVER_PATH or __ABAP_LSP_SERVER_DEBUG."
        },
        "abap-ls.serverTcpAddress": {
          "scope": "window",
          "type": "string",
          "default": "127.0.0.1:9472",
          "description": "host:port when serverTransport is \"tcp\" (or when __ABAP_LSP_CONNECT is set). Start the server with e.g. abap_lsp_server --listen 127.0.0.1:9472 or ABAP_LSP_LISTEN=127.0.0.1:9472."
        },
        "abap-ls.dependencyCache.path": {
          "scope": "machine-overridable",
          "type": "string",
          "default": "",
          "description": "Override the centralized ABAP dependency cache database path. Leave empty to use the operating system cache directory."
        }
      }
    },
    "languages": [
      {
        "id": "abap",
        "aliases": [
          "ABAP",
          "abap"
        ],
        "extensions": [
          ".abap"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap",
        "scopeName": "source.abap",
        "path": "./syntaxes/abap.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[abap]": {
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "test:e2e": "node ./client/out/test/runTest"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  }
}
