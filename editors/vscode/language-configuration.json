{
	"comments": {
		"lineComment": "\""
	},
	"brackets": [
		["(", ")"],
		["[", "]"]
	],
	"autoClosingPairs": [
		{
			"open": "(",
			"close": ")"
		},
		{
			"open": "[",
			"close": "]"
		}
	],
	"surroundingPairs": [
		{
			"open": "(",
			"close": ")"
		},
		{
			"open": "[",
			"close": "]"
		}
	],
	"folding": {
		"markers": {
			"start": "^[ \\t]*(?:CLASS\\b(?!-)|METHOD\\b|CASE\\b|IF\\b|INTERFACE\\b(?!-)|TRY\\b)",
			"end": "^[ \\t]*END(?:CLASS|METHOD|CASE|IF|INTERFACE|TRY)\\b\\.?"
		}
	}
}
