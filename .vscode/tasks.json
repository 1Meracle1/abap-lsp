{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Odin Binaries",
      "type": "shell",
      "command": ".\\build.bat",
      "group": "build"
    },
    {
      "label": "Build Odin Binaries (Release)",
      "type": "shell",
      "command": ".\\build.bat release",
      "group": "build"
    },
    {
      "label": "Test Odin Packages",
      "type": "shell",
      "command": ".\\test.bat",
      "group": "test"
    },
    {
      "label": "Build Legacy Rust Workspace",
      "type": "shell",
      "command": ".\\legacy\\build.bat",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Legacy Rust Server",
      "type": "shell",
      "command": ".\\legacy\\build.bat -p abap_lsp_server",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Legacy Rust Server (Release)",
      "type": "shell",
      "command": ".\\legacy\\build.bat release -p abap_lsp_server",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Test Legacy Rust Workspace",
      "type": "shell",
      "command": ".\\legacy\\test.bat",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Extension",
      "type": "npm",
      "script": "compile",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "path": "editors/vscode"
    },
    {
      "label": "Build Odin Language Server and Extension",
      "dependsOn": ["Build Odin Binaries", "Build Extension"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Odin Language Server (Release) and Extension",
      "dependsOn": ["Build Odin Binaries (Release)", "Build Extension"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Legacy Rust Server and Extension",
      "dependsOn": ["Build Legacy Rust Server", "Build Extension"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Legacy Rust Server (Release) and Extension",
      "dependsOn": ["Build Legacy Rust Server (Release)", "Build Extension"],
      "dependsOrder": "sequence"
    }
  ]
}
