{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Rust Workspace",
      "type": "shell",
      "command": ".\\build.bat",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Rust Server",
      "type": "shell",
      "command": ".\\build.bat -p abap_lsp_server",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Rust Server (Release)",
      "type": "shell",
      "command": ".\\build.bat release -p abap_lsp_server",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Test Rust Workspace",
      "type": "shell",
      "command": ".\\test.bat",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Build Extension",
      "type": "npm",
      "script": "compile",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "path": "editors/vscode"
    },
    {
      "label": "Build Rust Server and Extension",
      "dependsOn": ["Build Rust Server", "Build Extension"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Rust Server (Release) and Extension",
      "dependsOn": ["Build Rust Server (Release)", "Build Extension"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Build Legacy Server",
      "type": "shell",
      "command": ".\\legacy\\build.bat debug abap-lsp",
      "group": "build"
    },
    {
      "label": "Run Legacy Server",
      "type": "shell",
      "command": "raddbg --project:.\\legacy\\ols_raddbg_project --auto_run; Start-Sleep -Seconds 2",
      "group": "build"
    },
    {
      "label": "Build Legacy Server and Extension",
      "dependsOn": ["Build Legacy Server", "Run Legacy Server", "Build Extension"],
      "dependsOrder": "sequence"
    }
  ]
}
